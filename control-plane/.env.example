# Control Plane Environment Variables

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:5432/postgres"

# Open Policy Agent (OPA) Config
OPA_URL="http://localhost:8181/v1/data"

# GitOps Manifest Repository & Credentials
GIT_MANIFEST_REPO_URL="https://github.com/[YOUR-ORG]/k8s-manifests.git"
GIT_TOKEN="your-github-personal-access-token"
GIT_AUTHOR_NAME="Control Plane Bot"
GIT_AUTHOR_EMAIL="bot@controlplane.local"

# Security & Webhook Settings
# CI uses the per-repository secret registered in the database; this is not a global fallback.
WEBHOOK_SECRET="set-a-unique-secret-per-registered-repository"
# Shared secret required by ArgoCD when calling /api/v1/pipeline/deployed
ARGOCD_CALLBACK_TOKEN="set-a-unique-argocd-callback-token"
OPA_ALLOW_LOCAL_FALLBACK="false"

# CORS Security Settings
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://your-production-domain.com"

# App Environment
DEBUG=true
PORT=8000
